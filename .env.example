# =====================================================================
# korean-ASA-skills 환경 변수 템플릿
# ---------------------------------------------------------------------
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
#         .env 는 .gitignore 에 등록되어 있어 커밋되지 않는다.
#           cp .env.example .env
# =====================================================================

# ── KICE 학생평가지원포털 (STAS) ──────────────────────────────────────
# https://stas.moe.go.kr
# 성취기준·평가기준 검색, 수행평가/서논술형 평가도구, 채점기준,
# 평가결과 활용 자료실 등을 제공. 로그인 필요.
STAS_BASE_URL=https://stas.moe.go.kr
STAS_USER_ID=
STAS_PASSWORD=

# 내려받은 원자료를 저장할 로컬 경로 (.gitignore 처리됨)
STAS_DOWNLOAD_DIR=./downloads/stas

# 포털 호출 간 최소 대기(초). 서버 부하를 주지 않도록 1 이상 유지 권장.
STAS_REQUEST_DELAY=1.5
